{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Wanderer main and widget windows, including the remote server origin.",
  "windows": ["main", "widget-*", "server-settings"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*", "https://*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-desktop-ready",
    "allow-get-server-url",
    "allow-set-server-url",
    "allow-get-default-map",
    "allow-set-default-map",
    "allow-open-server-settings",
    "allow-open-widget",
    "allow-open-main",
    "allow-close-self",
    "allow-set-always-on-top",
    "allow-set-window-title",
    "allow-set-widget-opacity",
    "allow-zoom-in",
    "allow-zoom-out",
    "allow-zoom-reset"
  ]
}
